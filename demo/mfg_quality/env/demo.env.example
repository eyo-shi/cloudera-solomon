# 製造品質デモ (mfg_quality) — env 雛形
#
# 使い方（ローカル）:
#   cp demo/mfg_quality/env/demo.env.example .env
#   # 秘密情報（TRINO_PASSWORD, OPENSEARCH_PASSWORD, CAI_INFERENCE_API_KEY 等）だけ追記
#
# CML:
#   必要な行を .solomon/deploy.env にマージし Solomon Application を Restart
#
# 注意: 秘密情報を Git にコミットしないこと

# --- デモは CDW Trino + Iceberg（internal DuckDB では PuppyGraph とデータ共有不可）---
TRINO_MODE=external
TRINO_CATALOG=iceberg
TRINO_SCHEMA=mfg_quality
# TRINO_URL=https://your-trino-gateway:443
# TRINO_AUTH=auto
# TRINO_USER=
# TRINO_PASSWORD=

# --- Ossie（業種切替はこの 3 点 + TRINO_SCHEMA + OPENSEARCH_DOCS_INDEX）---
SOLOMON_SEMANTIC_ROOT=demo/mfg_quality/semantic
# SOLOMON_SEMANTIC_MODELS=   # 空 = models/*.yaml すべて

# --- Knowledge RAG（デモ推奨）---
SOLOMON_RAG_ENGINE=agent
SOLOMON_RAG_SOURCES=table,graph,search
SOLOMON_RAG_TOOL_MODE=auto
# SOLOMON_ROUTER_KNOWLEDGE_THRESHOLD=0.35

# --- OpenSearch 文書（Semantic Search / launcher）---
OPENSEARCH_MODE=external
# OPENSEARCH_CONNECTION_NAME=your-connection
# OPENSEARCH_ENDPOINT=https://...
OPENSEARCH_NAMESPACE=solomon
OPENSEARCH_DOCS_INDEX=solomon-mfg-docs
OPENSEARCH_EMBEDDING_DIM=1024
OPENSEARCH_DOCS_ANALYZER=cjk
OPENSEARCH_SEARCH_SCOPE=both
SOLOMON_DOC_SEARCH_EXPANSION=on
SOLOMON_DOC_SEARCH_MAX_VARIANTS=4

# --- PuppyGraph（Iceberg と同じカタログ）---
PUPPYGRAPH_MODE=external
# PUPPYGRAPH_URI=bolt://puppygraph-host:7687
# PUPPYGRAPH_USERNAME=puppygraph
# PUPPYGRAPH_PASSWORD=
# PUPPYGRAPH_HTTP_URL=http://puppygraph-host:8081

# --- LLM / 埋め込み ---
SOLOMON_LLM_PROVIDER=cai
SOLOMON_LLM_EMBEDDING_MODEL=bge-m3
# SOLOMON_LLM_AGENT_RAG_AGENT_MODEL=
# CAI_INFERENCE_BASE_URL=
# CAI_INFERENCE_API_KEY=

# --- データ投入 (demo.loader) ---
# DEMO_S3_PREFIX=s3://your-demo-bucket
# DEMO_HIVE_CATALOG=hive
# DEMO_STAGE_SCHEMA=default
# DEMO_PUPPYGRAPH_CATALOG=hms
# HIVE_METASTORE_URI=thrift://...
# ICEBERG_CATALOG=iceberg
# DEMO_EMBED_MAX_CHARS=2000
