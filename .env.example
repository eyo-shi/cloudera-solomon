# Solomon 環境変数サンプル。
#
# AMP Deploy 時に必要なのは SOLOMON_LOG_LEVEL / SOLOMON_DEMO_MODE のみ (両方 optional)。
# 以下は Deploy 後に Project → Settings → Advanced → Environment Variables で
# 設定する post-deploy 用の env セット。詳細は .project-metadata.yaml 冒頭の
# "Deploy 後の設定手順" を参照。
#
# ローカル開発 (venv) では本ファイルを .env にコピーして値を入れる。

# --- Solomon 本体 (両方 optional) ---
SOLOMON_LOG_LEVEL=INFO
SOLOMON_DEMO_MODE=off

# --- LLM プロバイダ選択 (cai / anthropic / openai / bedrock) ---
# default は cai (Cloudera AI Inference)。1 個だけ選ぶ。
SOLOMON_LLM_PROVIDER=cai
SOLOMON_LLM_ROUTER_MODEL=
SOLOMON_LLM_ANALYTICS_MODEL=
SOLOMON_LLM_EMBEDDING_MODEL=bge-m3

# provider=cai (Cloudera AI Inference, OpenAI 互換) のみ:
CAI_INFERENCE_BASE_URL=
CAI_INFERENCE_API_KEY=

# provider=anthropic のみ:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# provider=openai のみ:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# provider=bedrock のみ (IAM role 前提):
# AWS_REGION は下の S3 セクションと共有。

# --- Trino / CDW ---
# CML 環境: Data Connections で接続を登録し、その名前を指定する。
SOLOMON_TRINO_CONNECTION_NAME=
# 上が空でも Trino タイプの connection が 1 個なら自動採用。
# Data Connections を使わない環境 (local dev) は以下を直接指定:
SOLOMON_TRINO_HOST=
SOLOMON_TRINO_PORT=443
SOLOMON_TRINO_CATALOG=iceberg
SOLOMON_TRINO_SCHEMA=demo

# --- S3 (認証情報は IDBroker STS 経由でユーザーごとに払い出し) ---
SOLOMON_S3_CONNECTION_NAME=
SOLOMON_AWS_REGION=us-east-1
# MinIO などカスタム endpoint を使う場合のみ:
SOLOMON_S3_ENDPOINT_URL=

# --- Neo4j (Deploy 後に Neo4j Launcher Application Log から設定) ---
NEO4J_URI=bolt://cml-neo4j-REPLACE_FROM_APPLICATION_LOG.mlx-user-0:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Neo4jPass1234

# --- OpenSearch / Cloudera Semantic Search (Data Hub 外部クラスタ) ---
# Trino/CDW と同様、Solomon 内では OpenSearch を起動しない。
# Data Hub で "Semantic Search for AWS" を Provision 後、Management Console
# からエンドポイントを取得して Data Connection または env に設定する。
SOLOMON_OPENSEARCH_CONNECTION_NAME=
# Data Connections を使わない場合 (local dev 等):
SOLOMON_OPENSEARCH_ENDPOINT=
# SOLOMON_OPENSEARCH_HOST=  # ENDPOINT の別名
SOLOMON_OPENSEARCH_NAMESPACE=solomon
SOLOMON_OPENSEARCH_INDEX=
SOLOMON_OPENSEARCH_PORT=9200
SOLOMON_OPENSEARCH_SCHEME=https
SOLOMON_OPENSEARCH_USERNAME=
SOLOMON_OPENSEARCH_PASSWORD=
SOLOMON_OPENSEARCH_VERIFY_SSL=true
SOLOMON_OPENSEARCH_EMBEDDING_DIM=1024

# --- Cloudera Data Visualization (Deploy 後にプロジェクト内で有効化) ---
# Data メニューから Enable CDV 実行後に払い出される URL を入れる。
SOLOMON_CDV_BASE_URL=
SOLOMON_CDV_TRINO_CONNECTION_ID=
