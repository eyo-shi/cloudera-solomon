# Solomon 環境変数サンプル。
#
# CML (AMP) では Deploy フォームに出る項目と post-deploy 項目が分かれている (README 参照)。
#   - Deploy フォーム: 下の「Deploy フォーム」セクションの 4 項目
#   - Post-deploy:     .solomon/deploy.env (テンプレートは deploy/deploy.env.example)
#
# ローカル開発 (venv) では本ファイルを .env にコピーして値を入れる。
# .env はアプリが自動では読まないので、次のように起動する:
#   uvicorn solomon.api.main:app --reload --env-file .env
# (または同じ内容を .solomon/deploy.env に置く)
#
# 印の意味:
#   [必須]        その機能を使うなら必ず設定する
#   [条件付き必須] 記載の条件のときだけ必須
#   [任意]        既定値あり。変更したいときだけ設定する
# 起動自体に必須の変数は無い。未設定の機能は HTTP 503 + SetupGuide で止まる。

# =============================================================================
# Deploy フォーム (AMP Configuration 画面) — すべて [任意]
# =============================================================================
SOLOMON_LOG_LEVEL=INFO
# external (CDW Trino) | internal (warehouse-launcher)
TRINO_MODE=external
# internal (puppygraph-launcher) | external (外部 Bolt)
PUPPYGRAPH_MODE=internal
# external (Semantic Search 等) | internal (opensearch-launcher)
OPENSEARCH_MODE=external

# =============================================================================
# Post-deploy — CML では .solomon/deploy.env（deploy/deploy.env.example 参照）
# =============================================================================

# --- LLM プロバイダ [必須: チャット全般] ---
# cai / anthropic / openai / bedrock。未指定でも CAI_INFERENCE_* の 2 つがあれば cai。
SOLOMON_LLM_PROVIDER=cai

# provider=cai (Cloudera AI Inference, OpenAI 互換) [条件付き必須]:
# BASE_URL はエンドポイントの Code Sample の base_url をそのまま貼る
# (末尾は /v1 または /openai/v1)。下の role 別 BASE_URL をすべて指定する場合は省略可。
CAI_INFERENCE_BASE_URL=
# Workbench 内では空のままにする (呼び出しごとに /tmp/jwt の短命 JWT を使う)。
# 固定トークンは期限切れで 401 になる。Workbench 外からのときだけ CDP トークンを設定
CAI_INFERENCE_API_KEY=

# provider=anthropic [条件付き必須: ANTHROPIC_API_KEY]:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# provider=openai [条件付き必須: OPENAI_API_KEY]:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# provider=bedrock [条件付き必須: AWS_REGION (または SOLOMON_AWS_REGION)]、IAM role 前提。
# AWS_REGION は下の S3 セクションと共有。

# モデル / role / Agent 別の上書き [任意] — 未指定時は provider ごとの既定モデル
# light role (別名 SOLOMON_LLM_LIGHT_MODEL)
SOLOMON_LLM_ROUTER_MODEL=
# strong role (別名 SOLOMON_LLM_STRONG_MODEL)
SOLOMON_LLM_ANALYTICS_MODEL=
SOLOMON_LLM_EMBEDDING_MODEL=bge-m3
# SOLOMON_LLM_LIGHT_PROVIDER=cai
# SOLOMON_LLM_STRONG_PROVIDER=anthropic
# SOLOMON_LLM_EMBEDDING_PROVIDER=cai
# Role 別エンドポイント [任意] — CAI Inference はエンドポイントごとに URL が異なるため、
# role ごとに別モデルを使うときに指定する。未指定なら provider 共通の BASE_URL / API_KEY
# (別名: LIGHT → ROUTER, STRONG → ANALYTICS)。
# BASE_URL / *_MODEL は各エンドポイントの Code Sample の base_url / MODEL_ID をそのまま使う
# (例: google/gemma-4-26B-A4B-it。openai/ 接頭辞は自動で付く)
# SOLOMON_LLM_LIGHT_BASE_URL=https://<domain>/namespaces/serving-default/endpoints/<light用>/openai/v1
# SOLOMON_LLM_STRONG_BASE_URL=https://<domain>/namespaces/serving-default/endpoints/<strong用>/v1
# SOLOMON_LLM_EMBEDDING_BASE_URL=https://<domain>/namespaces/serving-default/endpoints/<embedding用>/v1
# SOLOMON_LLM_LIGHT_API_KEY=
# SOLOMON_LLM_STRONG_API_KEY=
# SOLOMON_LLM_EMBEDDING_API_KEY=
# Embedding の検索用 / 索引用 model ID [任意] — 非対称モデル (NVIDIA embedqa 等) で指定。
# 未指定なら両方 SOLOMON_LLM_EMBEDDING_MODEL
# SOLOMON_LLM_EMBEDDING_QUERY_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2-query
# SOLOMON_LLM_EMBEDDING_PASSAGE_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2-passage
# Embedding の出力次元 [任意] — Matryoshka 対応モデルで OPENSEARCH_EMBEDDING_DIM に合わせる
# SOLOMON_LLM_EMBEDDING_DIMENSIONS=1024
# Agent 別（KEY: intent_classifier, summary_writer, rag_synthesis, rag_agent 等）
# provider が既定 role と同じなら role のエンドポイントを引き継ぐ
# SOLOMON_LLM_AGENT_SUMMARY_WRITER_PROVIDER=openai
# SOLOMON_LLM_AGENT_SUMMARY_WRITER_MODEL=gpt-4o
# SOLOMON_LLM_AGENT_SUMMARY_WRITER_BASE_URL=
# SOLOMON_LLM_AGENT_SUMMARY_WRITER_API_KEY=
# SOLOMON_LLM_AGENT_RAG_AGENT_MODEL=   # Knowledge ReAct エージェント (既定 role=strong)

# --- Trino / Tables ---
# TRINO_MODE=external のとき [必須: TRINO_URL または TRINO_HOST のどちらか]
# Application env のみ（Data Connection / Custom Connection は使わない）
TRINO_HOST=
# TRINO_URL=https://default-trino-aws.dw-....cloudera.site:443  # HOST の代わりに 1 行で指定可
# 以下 [任意]
TRINO_PORT=443
TRINO_SCHEME=https
# true | false | CA bundle のパス
TRINO_VERIFY_SSL=true
TRINO_CATALOG=iceberg
TRINO_SCHEMA=demo
# 認証: auto（password あり→Basic、なし→Knox JWT）| jwt | basic
# Knox を経由しないローカル開発では TRINO_USER / TRINO_PASSWORD が [必須]
# TRINO_AUTH=auto
# TRINO_USER=
# TRINO_PASSWORD=
# TRINO_MODE=internal で DNS 不通時のみ (warehouse-launcher):
# TRINO_ENDPOINT=http://host:8080
# 旧名 SOLOMON_TRINO_* も後方互換で読み取る。

# --- S3 / Storage タブ (docs/s3_connectivity.md) ---
# [必須: Storage タブ] 実在するバケット名 (カンマ区切り)。未設定は demo-bucket 表示・添付不可
# 例: your-bucket
SOLOMON_S3_BUCKETS=
# [必須: どちらか] CDP on AWS 推奨: Knox JWT → IDBroker → STS (S3 Data Connection 不要)
SOLOMON_IDBROKER_URL=
# IDBroker を使わない場合のみ S3 Data Connection 名 (省略時は自動検出)
SOLOMON_S3_CONNECTION_NAME=
# [任意] リージョン (Data Connection に region があればそちら優先)
AWS_REGION=us-east-1
# [任意] MinIO などカスタム endpoint を使う場合のみ
SOLOMON_S3_ENDPOINT_URL=

# --- PuppyGraph / Graph タブ ---
# PUPPYGRAPH_MODE=external のとき [必須: PUPPYGRAPH_URI]
# internal では .solomon/puppygraph_endpoints.json から自動解決 (DNS 不通時のみ URI を設定)
# PUPPYGRAPH_URI=bolt://localhost:7687
# [任意] 認証 (internal では launcher Pod と同じ値にする)
# PUPPYGRAPH_USERNAME=puppygraph
# PUPPYGRAPH_PASSWORD=puppygraph123
# [任意] internal launcher チューニング
# PUPPYGRAPH_MEMORY=8Gi
# PUPPYGRAPH_USE_PVC=false
# PUPPYGRAPH_IMAGE=puppygraph/puppygraph:1.15.0
# Air-gap: PUPPYGRAPH_IMAGE=registry.example/solomon/puppygraph:1.15.0

# --- OpenSearch / Search タブ ---
# OPENSEARCH_MODE=external のとき
# [必須: どちらか] OpenSearch Data Connection 名 (省略時は自動検出) または ENDPOINT
OPENSEARCH_CONNECTION_NAME=
OPENSEARCH_ENDPOINT=
# OPENSEARCH_URL=   # ENDPOINT の別名（CDE と同じ Knox URL）
# OPENSEARCH_HOST=  # ENDPOINT の別名
# 以下 [任意]
# 別名 OPENSEARCH_USER
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https
OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_NAMESPACE=solomon
# dataset カタログ (既定 {namespace}-datasets)
OPENSEARCH_INDEX=
OPENSEARCH_EMBEDDING_DIM=1024
# 業務文書インデックス
# OPENSEARCH_DOCS_INDEX=support_notes   # 既定: Ossie の document_index → {namespace}-docs
# OPENSEARCH_DOCS_ANALYZER=cjk          # cjk | kuromoji
# Search タブの表示対象
# OPENSEARCH_SEARCH_SCOPE=datasets      # datasets | docs | both (既定 datasets)
# SOLOMON_DOC_SEARCH_EXPANSION=on       # on | off — LLM 言い換え + 複数検索 RRF
# SOLOMON_DOC_SEARCH_MAX_VARIANTS=4
#
# OPENSEARCH_MODE=internal のとき [任意] (launcher チューニング / DNS 不通時)
# OPENSEARCH_MEMORY=2Gi
# OPENSEARCH_USE_PVC=false
# OPENSEARCH_ENDPOINT=

# --- Cloudera Data Visualization ---
# [必須: ダッシュボード生成] Data メニューから Enable CDV 実行後に払い出される URL
SOLOMON_CDV_BASE_URL=
# [任意]
SOLOMON_CDV_TRINO_CONNECTION_ID=

# --- Knowledge RAG [任意] ---
# SOLOMON_RAG_ENGINE=agent          # agent (ReAct) | heuristic (従来 3 段)
# SOLOMON_RAG_SOURCES=table,graph,search   # UI 未指定時の既定ソース
# SOLOMON_RAG_TOOL_MODE=auto        # auto | native (function calling) | json
# SOLOMON_GRAPH_SCHEMA_FILE=semantic/graph/schema.yaml

# --- Semantic layer (Apache Ossie) [任意] ---
# SOLOMON_SEMANTIC_ROOT=./semantic
# SOLOMON_SEMANTIC_MODELS=sample_orders   # 未設定なら models/*.yaml をすべて読込
# SOLOMON_ROUTER_KNOWLEDGE_THRESHOLD=0.35 # heuristic Router: Ossie 一致で KNOWLEDGE_RAG

# --- Air-gap AMP (Deploy 前に Project Settings へ) [任意] ---
# SOLOMON_SKIP_UI_BUILD=true
# 接続ゾーンで npm run build した solomon/api/static/ をプロジェクトに同梱すること

# =============================================================================
# Demo (demo/SETUP.md) [任意] — 業種固有の値は demo/<domain>/env/demo.env.example 参照
# =============================================================================
# 事前確認: PYTHONPATH=. python -m demo.checks.preflight --semantic-root demo/mfg_quality/semantic
#
# --- demo.loader（Iceberg / PuppyGraph / OpenSearch 投入）---
# DEMO_S3_PREFIX=s3://demo-data
# DEMO_HIVE_CATALOG=hive
# DEMO_STAGE_SCHEMA=default
# DEMO_EMBED_MAX_CHARS=2000
# PUPPYGRAPH_HTTP_URL=http://127.0.0.1:8081
# PUPPYGRAPH_HTTP_PORT=8081
# DEMO_PUPPYGRAPH_CATALOG=hms
# ICEBERG_CATALOG=iceberg
# HIVE_METASTORE_URI=thrift://hive-metastore:9083
# ICEBERG_REST_URI=
# ICEBERG_WAREHOUSE=s3://warehouse/
#
# --- demo.validate（エージェント検証の HTTP ヘッダ）---
# DEMO_VALIDATE_HTTP_HEADERS={"Authorization":"Bearer …"}
