# Solomon 環境変数サンプル。
#
# ローカル開発 (venv) では本ファイルを .env にコピーして値を入れる。
# CML では Deploy フォームに出る項目と post-deploy 項目が分かれている (README 参照)。

# =============================================================================
# Deploy フォーム (AMP Configuration 画面) — すべて optional
# =============================================================================
SOLOMON_LOG_LEVEL=INFO
TRINO_MODE=external
NEO4J_MODE=internal
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=Neo4jPass1234
OPENSEARCH_MODE=external

# =============================================================================
# Post-deploy — Project → Settings → Advanced → Environment Variables
# =============================================================================

# --- LLM プロバイダ (cai / anthropic / openai / bedrock) ---

# Router 意図分類 (post-deploy)。未設定 = heuristic。LLM 分類する場合:
# SOLOMON_ROUTER_MODE=llm

# default は cai (Cloudera AI Inference)。1 個だけ選ぶ。
SOLOMON_LLM_PROVIDER=cai
SOLOMON_LLM_ROUTER_MODEL=
SOLOMON_LLM_ANALYTICS_MODEL=
SOLOMON_LLM_EMBEDDING_MODEL=bge-m3

# provider=cai (Cloudera AI Inference, OpenAI 互換) のみ:
CAI_INFERENCE_BASE_URL=
CAI_INFERENCE_API_KEY=

# provider=anthropic のみ:
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# provider=openai のみ:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# provider=bedrock のみ (IAM role 前提):
# AWS_REGION は下の S3 セクションと共有。

# --- Trino / Tables (TRINO_MODE=external のとき) ---
# Application env のみ（Data Connection / Custom Connection は使わない）
TRINO_HOST=
# TRINO_URL=https://default-trino-aws.dw-....cloudera.site:443  # HOST の別名（1 行で可）
TRINO_PORT=443
TRINO_SCHEME=https
TRINO_VERIFY_SSL=true
TRINO_CATALOG=iceberg
TRINO_SCHEMA=demo
# 認証: auto（password あり→Basic、なし→Knox JWT）| jwt | basic
# TRINO_AUTH=auto
# TRINO_USER=
# TRINO_PASSWORD=
# 製造 Silver（CDE Spark 取込）。デモ QA は inspection_silver を参照
SOLOMON_SILVER_SCHEMA=inspection_silver
# internal モードで DNS 不通時のみ (warehouse-launcher):
# TRINO_ENDPOINT=http://host:8080
# 旧名 SOLOMON_TRINO_* も後方互換で読み取る。

# --- S3 (docs/s3_connectivity.md) ---
# Storage タブのバケット一覧 (必ず実バケット名。未設定は demo-bucket)
SOLOMON_S3_BUCKETS=eyda-buk-edf7cfcf
# CDP on AWS 推奨: Knox JWT → IDBroker → STS (S3 Data Connection 不要)
SOLOMON_IDBROKER_URL=
SOLOMON_AWS_REGION=us-east-1
# IDBroker を使わない場合のみ S3 Data Connection 名
SOLOMON_S3_CONNECTION_NAME=
# MinIO などカスタム endpoint を使う場合のみ:
SOLOMON_S3_ENDPOINT_URL=

# --- Neo4j: external モード (NEO4J_MODE=external) ---
# NEO4J_USERNAME / NEO4J_PASSWORD は Deploy フォームで設定済み
NEO4J_URI=

# --- Neo4j: internal モード optional (launcher チューニング / DNS 不通時) ---
# NEO4J_MEMORY=4Gi
# NEO4J_USE_PVC=false
# NEO4J_SERVICE_TYPE=LoadBalancer
# NEO4J_URI=
# NEO4J_EXTERNAL_URI=

# --- OpenSearch: external モード (OPENSEARCH_MODE=external) ---
OPENSEARCH_CONNECTION_NAME=
# Data Connections を使わない場合 (local dev 等):
OPENSEARCH_ENDPOINT=
# OPENSEARCH_URL=   # CDE と同じ Knox URL（ENDPOINT の別名）
# OPENSEARCH_HOST=  # ENDPOINT の別名
# OPENSEARCH_USER=  # USERNAME の別名
OPENSEARCH_NAMESPACE=solomon
OPENSEARCH_INDEX=
# CDE Spark Bronze 取込（Solomon Search タブの solomon-datasets とは別）
OPENSEARCH_INSPECTION_INDEX_PREFIX=inspection
# Search タブ: inspection (Bronze) | datasets (solomon-datasets) | both
OPENSEARCH_SEARCH_SCOPE=inspection
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=https
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_SSL=true
OPENSEARCH_EMBEDDING_DIM=1024

# --- OpenSearch: internal モード optional (launcher チューニング / DNS 不通時) ---
# OPENSEARCH_MEMORY=2Gi
# OPENSEARCH_USE_PVC=false
# OPENSEARCH_ENDPOINT=

# --- Cloudera Data Visualization ---
# Data メニューから Enable CDV 実行後に払い出される URL を入れる。
SOLOMON_CDV_BASE_URL=
SOLOMON_CDV_TRINO_CONNECTION_ID=
