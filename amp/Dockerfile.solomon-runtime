# Solomon カスタム Runtime (PBJ Workbench / Python 3.12)
#
# Cloudera 公式 PBJ Workbench イメージを拡張し、pyproject.toml の本番依存を
# 事前インストールする。AMP Deploy 時の pip install 時間を短縮する。
#
# 事前準備 (Mac から build する場合):
#   1. Cloudera ライセンスから Credentials Generator で username/password を取得
#      https://www.cloudera.com/downloads.html
#   2. docker login docker.repository.cloudera.com
#   3. ベースイメージのタグは repo-assembly.json で確認 (latest):
#      https://archive.cloudera.com/ml-runtimes/latest/artifacts/repo-assembly.json
#      Solomon 向け: editor=PBJ Workbench, kernel=Python 3.12, edition=Standard
#      → ml-runtime-pbj-workbench-python3.12-standard:2026.08.1-b5
#      未 login だと "not found" になる
#
# ビルド例 (リポジトリ root から):
#   docker build --platform=linux/amd64 \
#     -f amp/Dockerfile.solomon-runtime \
#     -t your-registry.example.com/ml-runtime-solomon-python3.12:1.0.0 \
#     .
#
# Apple Silicon (M1/M2/M3/M4/M5 等) Mac では --platform=linux/amd64 が必須。
# Cloudera AI の Runtime は amd64 Linux のため、arm64 イメージは使えない。
# エミュレーション経由のビルドは時間がかかる (30分〜1時間+) ので、
# 可能なら Linux CI / Cloudera 環境上での build を推奨。
#
# buildx 利用例:
#   docker buildx create --use --name solomon-builder  # 初回のみ
#   docker buildx build --platform=linux/amd64 \
#     -f amp/Dockerfile.solomon-runtime \
#     -t your-registry.example.com/ml-runtime-solomon-python3.12:1.0.0 \
#     --push .
#
# ベースイメージ更新時は repo-assembly.json の image_identifier を確認し、
# --build-arg BASE_IMAGE=... で上書き可能。
#
# 登録: Site Administration → Runtime Catalog → Add Runtime → Validate

# repo-assembly.json (2026.08.1-b5) — タグに -b5 サフィックスが必要
# TARGETPLATFORM は `docker build --platform=linux/amd64` で自動設定される
ARG TARGETPLATFORM
ARG BASE_IMAGE=docker.repository.cloudera.com/cloudera/cdsw/ml-runtime-pbj-workbench-python3.12-standard:2026.08.1-b5
FROM --platform=$TARGETPLATFORM ${BASE_IMAGE}

USER root

# ビルド時は /usr/local へインストール (Cloudera カスタム Runtime 要件)
RUN pip3 config set install.user false

COPY amp/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements-runtime.txt \
    && rm -f /tmp/requirements-runtime.txt

# UI ビルド (amp/02_build_ui.py) 用 Node.js 20 — nvm 導入を省略できる
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# Runtime 起動後はユーザー領域 (/home/cdsw) へ pip — 以降 RUN pip は禁止
RUN /bin/bash -c "echo -e '[install]\nuser = true'" > /etc/pip.conf

# Edition 名は Cloudera 公式 Runtime と被らないこと
ENV ML_RUNTIME_EDITION="Solomon Edition" \
    ML_RUNTIME_SHORT_VERSION="1.0" \
    ML_RUNTIME_MAINTENANCE_VERSION="1" \
    ML_RUNTIME_DESCRIPTION="Solomon AMP: crewai, neo4j, opensearch, fastapi, nodejs 20 pre-installed"

ENV ML_RUNTIME_FULL_VERSION="${ML_RUNTIME_SHORT_VERSION}.${ML_RUNTIME_MAINTENANCE_VERSION}"

LABEL com.cloudera.ml.runtime.edition=${ML_RUNTIME_EDITION} \
      com.cloudera.ml.runtime.full-version=${ML_RUNTIME_FULL_VERSION} \
      com.cloudera.ml.runtime.short-version=${ML_RUNTIME_SHORT_VERSION} \
      com.cloudera.ml.runtime.maintenance-version=${ML_RUNTIME_MAINTENANCE_VERSION} \
      com.cloudera.ml.runtime.description=${ML_RUNTIME_DESCRIPTION}
