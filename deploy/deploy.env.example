# Solomon post-deploy 設定 (CML Workbench)
#
# 1. AMP Deploy 時 amp/06 が無ければ .solomon/deploy.env をここから生成
# 2. 編集後 Solomon Application を Restart
# 3. 秘匿のみ .solomon/secrets.env (Git 除外) に分離可

# --- Expert (将来の Profile ID) ---
# SOLOMON_EXPERT_PROFILE=generic

# --- LLM (provider=cai / anthropic / openai / bedrock) ---
SOLOMON_LLM_PROVIDER=cai

# --- Trino (TRINO_MODE=external) ---
# TRINO_URL=https://default-trino-aws.example:443

# --- S3 Storage タブ ---
# SOLOMON_S3_BUCKETS=your-bucket
# SOLOMON_IDBROKER_URL=

# --- PuppyGraph (openCypher / Bolt) ---
# Iceberg / PostgreSQL / Trino catalog + graph schema は PuppyGraph 側で定義
# internal launcher: PUPPYGRAPH_IMAGE (Project Settings、既定 puppygraph/puppygraph:1.15.0)
# PUPPYGRAPH_MODE=internal
# PUPPYGRAPH_URI=bolt://puppygraph-host:7687
# PUPPYGRAPH_USERNAME=puppygraph
# PUPPYGRAPH_PASSWORD=puppygraph123

# --- OpenSearch (OPENSEARCH_MODE=external) ---
# OPENSEARCH_CONNECTION_NAME=
# OPENSEARCH_ENDPOINT=
# OPENSEARCH_NAMESPACE=solomon
# OPENSEARCH_INDEX=          # datasets タブ用（Bronze 等）
# OPENSEARCH_EMBEDDING_DIM=1024
# OPENSEARCH_DOCS_INDEX=     # 業務文書チャンク用（デモは demo/<domain>/env を参照）
# OPENSEARCH_DOCS_ANALYZER=cjk
# OPENSEARCH_SEARCH_SCOPE=both
# SOLOMON_DOC_SEARCH_EXPANSION=on
# SOLOMON_DOC_SEARCH_MAX_VARIANTS=4

# --- Semantic / RAG（デモ・本番共通）---
# SOLOMON_SEMANTIC_ROOT=./semantic
# SOLOMON_SEMANTIC_MODELS=
# SOLOMON_RAG_ENGINE=agent
# SOLOMON_RAG_SOURCES=table,graph,search
# SOLOMON_RAG_TOOL_MODE=auto
# SOLOMON_ROUTER_KNOWLEDGE_THRESHOLD=0.35
# SOLOMON_LLM_AGENT_RAG_AGENT_MODEL=

# --- デモ投入 (demo.loader) — 値は環境依存 ---
# DEMO_S3_PREFIX=s3://demo-data
# DEMO_HIVE_CATALOG=hive
# DEMO_STAGE_SCHEMA=default
# DEMO_PUPPYGRAPH_CATALOG=hms
# PUPPYGRAPH_HTTP_URL=
# DEMO_EMBED_MAX_CHARS=2000
# ICEBERG_CATALOG= / HIVE_METASTORE_URI= / ICEBERG_REST_URI=

# --- CDV ---
# SOLOMON_CDV_BASE_URL=

# --- Semantic / RAG (demo 含む) ---
# SOLOMON_SEMANTIC_ROOT=./semantic
# SOLOMON_SEMANTIC_MODELS=
# SOLOMON_RAG_ENGINE=agent
# SOLOMON_RAG_SOURCES=table,graph,search
# SOLOMON_RAG_TOOL_MODE=auto
# SOLOMON_ROUTER_KNOWLEDGE_THRESHOLD=0.35
# OPENSEARCH_DOCS_INDEX=
# OPENSEARCH_DOCS_ANALYZER=cjk
# OPENSEARCH_SEARCH_SCOPE=both
# SOLOMON_DOC_SEARCH_EXPANSION=on
# SOLOMON_DOC_SEARCH_MAX_VARIANTS=4
# SOLOMON_LLM_AGENT_RAG_AGENT_MODEL=

# --- Demo loader / validate (demo/SETUP.md) ---
# DEMO_S3_PREFIX=s3://demo-data
# PUPPYGRAPH_HTTP_URL=
# DEMO_PUPPYGRAPH_CATALOG=hms
# DEMO_EMBED_MAX_CHARS=2000
# HIVE_METASTORE_URI=
# DEMO_VALIDATE_HTTP_HEADERS=
