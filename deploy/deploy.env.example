# Solomon post-deploy 設定 (CML Workbench)
#
# 1. AMP Deploy 時、.solomon/deploy.env が無ければ amp/06 がこのファイルをコピーして生成する
# 2. 必要な行のコメントを外して値を入れ、Solomon Application を Restart する
# 3. API キー等の秘匿値は .solomon/secrets.env (Git 除外) に分けてもよい
#
# -----------------------------------------------------------------------------
# 印の意味
#   [必須]       その機能を使うなら必ず設定する
#   [条件付き]   行に書いた条件のときだけ必須
#   [任意]       既定値あり。変えたいときだけ設定する
# 起動に必須の変数は無い。未設定の機能だけが HTTP 503 (UI の Setup Guide) で止まる。
#
# AMP 既定 (TRINO_MODE=external / PUPPYGRAPH_MODE=internal / OPENSEARCH_MODE=external)
# で全タブを使うときに書く最小セット:
#   チャット  : SOLOMON_LLM_PROVIDER, CAI_INFERENCE_BASE_URL (または role 別 BASE_URL),
#               SOLOMON_LLM_LIGHT_MODEL / _STRONG_MODEL / _EMBEDDING_MODEL
#   Tables    : TRINO_URL
#   Storage   : SOLOMON_S3_BUCKETS, SOLOMON_IDBROKER_URL
#   Dashboard : SOLOMON_CDV_BASE_URL
#   Graph     : なし (internal launcher から自動解決)
#   Search    : なし (OpenSearch Data Connection が自動検出されれば)
# -----------------------------------------------------------------------------
#
# 優先度 (solomon/infra/deploy_env.py):
#   - Project 環境変数 (AMP Deploy フォームの値を含む) が非空ならそちらが優先され、
#     このファイルは未設定 / 空のキーだけを埋める。
#     例: Deploy フォームで TRINO_MODE=external のまま Deploy した場合、ここに
#     TRINO_MODE=internal と書いても反映されない (Project Settings 側を変更する)。
#   - deploy.env と secrets.env に同じキーを書かない (先に読む deploy.env が勝つ)。
#   - SOLOMON_DEPLOY_ENV_OVERRIDE=true はファイル読込前に判定されるため、
#     このファイルではなく Project 環境変数に設定する。
#
# 注意: 値の後ろに "# コメント" を書かない (コメントも値として読み込まれる)。
# 変数の詳細はリポジトリ直下の .env.example / README 参照。

# =============================================================================
# LLM — チャット全般 (Router / Knowledge RAG / Analytics)
# =============================================================================
# [必須] cai / anthropic / openai / bedrock
SOLOMON_LLM_PROVIDER=cai

# --- provider=cai (Cloudera AI Inference) ---
# [必須: どちらか] エンドポイント URL
#   (a) 全 role 共通の CAI_INFERENCE_BASE_URL
#   (b) role ごとの SOLOMON_LLM_{LIGHT,STRONG,EMBEDDING}_BASE_URL
#       (CAI Inference はエンドポイントごとに URL が異なる。未指定の role は (a) を使う)
# 値は各エンドポイントの Code Sample の base_url をそのまま貼る (末尾 /v1 または /openai/v1)
# CAI_INFERENCE_BASE_URL=
# SOLOMON_LLM_LIGHT_BASE_URL=https://<domain>/namespaces/serving-default/endpoints/<light用>/openai/v1
# SOLOMON_LLM_STRONG_BASE_URL=https://<domain>/namespaces/serving-default/endpoints/<strong用>/v1
# SOLOMON_LLM_EMBEDDING_BASE_URL=https://<domain>/namespaces/serving-default/endpoints/<embedding用>/v1
#
# [必須 (実質)] model ID。既定値 (llama-3-8b-instruct / llama-3-70b-instruct / bge-m3) が
# エンドポイントのモデルと一致しない限り設定する。Code Sample の MODEL_ID をそのまま貼る
# (openai/ 接頭辞は自動で付く)。embedding が使えないと文書検索はキーワード検索のみになる
# SOLOMON_LLM_LIGHT_MODEL=google/gemma-4-26B-A4B-it
# SOLOMON_LLM_STRONG_MODEL=nvidia/nemotron-3-super-120b-a12b
# SOLOMON_LLM_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
#
# [不要] API キー: Workbench 内では書かない (/tmp/jwt の短命 JWT を呼び出しごとに使う。
# 固定トークンは期限切れで 401 になる)。Workbench 外から呼ぶときだけ CDP トークンを設定
# CAI_INFERENCE_API_KEY=
#
# [任意] 非対称 embedding (NVIDIA embedqa 等) の検索用 / 索引用 model ID。
# 未指定なら両方 SOLOMON_LLM_EMBEDDING_MODEL
# SOLOMON_LLM_EMBEDDING_QUERY_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2-query
# SOLOMON_LLM_EMBEDDING_PASSAGE_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2-passage
# [任意] 出力次元 (Matryoshka 対応モデル)。未指定ならモデル既定。
# 設定するなら OPENSEARCH_EMBEDDING_DIM と同じ値にする
# SOLOMON_LLM_EMBEDDING_DIMENSIONS=1024

# --- provider=anthropic ---
# [条件付き: provider=anthropic]
# ANTHROPIC_API_KEY=
# --- provider=openai ---
# [条件付き: provider=openai]
# OPENAI_API_KEY=
# --- provider=bedrock (IAM role 前提) ---
# [条件付き: provider=bedrock] (S3 セクションの AWS_REGION と共有)
# AWS_REGION=us-east-1

# =============================================================================
# Trino / Tables タブ
# =============================================================================
# [条件付き: TRINO_MODE=external (AMP 既定)] TRINO_URL または TRINO_HOST
# TRINO_URL=https://default-trino-aws.example:443
# [条件付き: Knox を経由しない場合のみ] Basic 認証
# TRINO_USER=
# TRINO_PASSWORD=
# [任意] 既定 iceberg / demo
# TRINO_CATALOG=iceberg
# TRINO_SCHEMA=demo

# =============================================================================
# S3 / Storage タブ・チャット添付 (docs/s3_connectivity.md)
# =============================================================================
# [必須] 実在するバケット名 (カンマ区切り)。未設定だと添付アップロード不可
# SOLOMON_S3_BUCKETS=your-bucket
# [必須: どちらか] IDBroker URL (推奨) または S3 Data Connection (自動検出)
# SOLOMON_IDBROKER_URL=
# [任意] 既定 us-east-1
# AWS_REGION=us-east-1

# =============================================================================
# PuppyGraph / Graph タブ (openCypher / Bolt)
# =============================================================================
# Iceberg / PostgreSQL / Trino catalog と graph schema は PuppyGraph 側で定義する。
# [条件付き: PUPPYGRAPH_MODE=external] Bolt URI
#   internal (AMP 既定) では .solomon/puppygraph_endpoints.json から自動解決
#   (internal で DNS 不通のときだけ設定)
# PUPPYGRAPH_URI=bolt://puppygraph-host:7687
# [任意] 認証 (既定 puppygraph / puppygraph123)
#   internal では launcher (1_start-puppygraph) はこのファイルを読まない。既定から
#   変えるときは Project 環境変数に設定する (ここだけに書くと Solomon と launcher で不一致)
# PUPPYGRAPH_USERNAME=puppygraph
# PUPPYGRAPH_PASSWORD=puppygraph123
# launcher 側の設定 (このファイルでは効かない。Project 環境変数に設定して launcher を Restart):
#   PUPPYGRAPH_IMAGE              既定 puppygraph/puppygraph:1.15.0 (Air-gap ではミラー先)
#   PUPPYGRAPH_CONTAINER_UID/GID  既定 1000/1000 (イメージの puppy ユーザー。runAsNonRoot 対策)

# =============================================================================
# OpenSearch / Search タブ
# =============================================================================
# [条件付き: OPENSEARCH_MODE=external (AMP 既定) で Data Connection が自動検出されない場合]
#   Data Connection 名 または ENDPOINT のどちらか
# OPENSEARCH_CONNECTION_NAME=
# OPENSEARCH_ENDPOINT=
# [条件付き: ENDPOINT 直指定で認証が要る場合]
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# [任意] インデックス namespace (既定 solomon)
# OPENSEARCH_NAMESPACE=solomon
# [任意] dataset カタログ用 index (既定 {namespace}-datasets)
# OPENSEARCH_INDEX=
# [任意] ベクトル次元 (既定 1024)。embedding モデルの出力次元と一致させる
# OPENSEARCH_EMBEDDING_DIM=1024
# [任意] 業務文書チャンク用 index (既定: Ossie の document_index → {namespace}-docs)
# OPENSEARCH_DOCS_INDEX=
# [任意] cjk (既定) | kuromoji
# OPENSEARCH_DOCS_ANALYZER=cjk
# [任意] demo.loader の _bulk 1 回あたりの本文上限 bytes (既定 12288)。
#   CDP Semantic Search (Knox) は約 16 KiB を超える本文で 500 になるため小さくしている
# OPENSEARCH_BULK_MAX_BYTES=12288
# [任意] Search タブの表示対象: datasets (既定) | docs | both
# OPENSEARCH_SEARCH_SCOPE=both
# [任意] LLM 言い換え + 複数検索 (既定 on / 4)
# SOLOMON_DOC_SEARCH_EXPANSION=on
# SOLOMON_DOC_SEARCH_MAX_VARIANTS=4

# =============================================================================
# Cloudera Data Visualization / ダッシュボード生成
# =============================================================================
# [必須] Data メニューで CDV を Enable 後に払い出される URL
# SOLOMON_CDV_BASE_URL=

# =============================================================================
# Semantic / Knowledge RAG — すべて [任意]
# =============================================================================
# 既定 ./semantic (デモは demo/<domain>/semantic)
# SOLOMON_SEMANTIC_ROOT=./semantic
# 空 = models/*.yaml すべて
# SOLOMON_SEMANTIC_MODELS=
# agent (既定, ReAct) | heuristic
# SOLOMON_RAG_ENGINE=agent
# SOLOMON_RAG_SOURCES=table,graph,search
# auto (既定) | native | json
# SOLOMON_RAG_TOOL_MODE=auto
# SOLOMON_ROUTER_KNOWLEDGE_THRESHOLD=0.35
# ReAct エージェントのモデル (既定は strong role)
# SOLOMON_LLM_AGENT_RAG_AGENT_MODEL=

# =============================================================================
# Demo loader / validate (demo/SETUP.md) — Solomon 本体は使わない。値は環境依存
# =============================================================================
# [必須: demo.loader] Parquet の upload 先 (既定 s3://demo-data は通常存在しない)
# DEMO_S3_PREFIX=s3://your-demo-bucket
# --- loader --target graph (PuppyGraph schema の ${...} に埋め込む。未設定だと置換されない) ---
# [必須: graph 投入] PuppyGraph 側で付ける Iceberg カタログ名
# ICEBERG_CATALOG=iceberg
# [任意] hms (既定) | rest
# DEMO_PUPPYGRAPH_CATALOG=hms
# [条件付き: DEMO_PUPPYGRAPH_CATALOG=hms] Hive Metastore thrift URI
# HIVE_METASTORE_URI=thrift://hive-metastore:9083
# [条件付き: DEMO_PUPPYGRAPH_CATALOG=rest] Iceberg REST URI / warehouse
# ICEBERG_REST_URI=
# ICEBERG_WAREHOUSE=s3://your-warehouse/
# [任意] loader 方式 A の hive カタログ / staging schema (既定 hive / default)
# DEMO_HIVE_CATALOG=hive
# DEMO_STAGE_SCHEMA=default
# [任意] 埋め込み前の切り詰め文字数 (既定 2000)
# DEMO_EMBED_MAX_CHARS=2000
# [任意] PuppyGraph HTTP API (既定 http://127.0.0.1:8081)
# PUPPYGRAPH_HTTP_URL=
# [任意] demo.validate --level agent が Solomon API を呼ぶときの HTTP ヘッダ (JSON)
# DEMO_VALIDATE_HTTP_HEADERS=
